# Rust
# Cargo.lock is committed deliberately — this is an application (Tauri app),
# not a library, so a reproducible dependency graph is wanted.
/target/

# Node / frontend
node_modules/
dist/
build/

# Tauri
src-tauri/target/

# OS cruft
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Claude Code local settings/state (machine-specific, not shared)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Model files fetched for a release build (app/scripts/fetch-bundled-models.mjs)
app/src-tauri/bundled-models/

# The AI helper copied for a release build (app/scripts/prepare-ai-helper.mjs)
app/src-tauri/binaries/

# The 208 MB removal model, copied here for `make dev` (see models/INPAINT_MODEL.md); never committed
models/lama_fp32.onnx

# wdio backend traces (captured on CI runs; older ones were committed by mistake)
app/logs/wdio-*.log
