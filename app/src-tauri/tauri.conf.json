{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emulsion",
  "version": "0.1.0",
  "identifier": "dev.alfredwei.emulsion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Emulsion",
        "width": 1400,
        "height": 800,
        "minWidth": 1360,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https: http://localhost:* http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'",
      "capabilities": ["default"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/thumbnails/*", "$APPDATA/previews/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Photography",
    "shortDescription": "Local-first photo library and RAW editor",
    "targets": "all",
    "resources": {
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../THIRD_PARTY_LIBRARIES.md": "THIRD_PARTY_LIBRARIES.md",
      "../../licenses/": "licenses/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
